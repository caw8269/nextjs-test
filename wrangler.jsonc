{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "nextjs-auto-deploy",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-10-9",
    "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    }
}